# OrbitX Browser - Environment Variables
# Copy this file to .env and add your real API keys

# Google Custom Search API
# Get from: https://console.cloud.google.com/
REACT_APP_GOOGLE_API_KEY=your_google_api_key_here
REACT_APP_GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here

# Bing Search API  
# Get from: https://azure.microsoft.com/en-us/services/cognitive-services/bing-web-search-api/
REACT_APP_BING_API_KEY=your_bing_api_key_here

# SerpAPI
# Get from: https://serpapi.com/
REACT_APP_SERPAPI_KEY=your_serpapi_key_here

# DuckDuckGo - No API key needed (Free)
REACT_APP_DUCKDUCKGO_ENABLED=true
